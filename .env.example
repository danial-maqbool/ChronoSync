CHRONOSYNC_DATA_DIR=data
CHRONOSYNC_HOST=127.0.0.1
CHRONOSYNC_PORT=8765
CHRONOSYNC_AI_ENABLED=false
CHRONOSYNC_MODE=local
# Hosted mode: set MODE=cloud and provision these as private hosting variables.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# CHRONOSYNC_PUBLIC_URL=https://your-app.onrender.com
# CHRONOSYNC_INVITE_CODE=<random secret of at least 32 characters>
# Render supplies the public URL automatically via RENDER_EXTERNAL_URL.
